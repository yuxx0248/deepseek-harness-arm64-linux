From 6e4e494fa08b6da07b22e2ddbeba57e8821baca2 Mon Sep 17 00:00:00 2001
From: zuohang <jimyu1994@gmail.com>
Date: Tue, 24 Nov 2026 15:57:28 -0800
Subject: [PATCH 04/20] Extend publish-target schemas and upload-plan target
 map to linux-arm64

---
 apps/desktop-publisher/src/desktop-publish-targets.ts | 2 +-
 apps/desktop-publisher/src/desktop-release-store.ts   | 2 +-
 apps/desktop/scripts/desktop-upload-plan.ts           | 1 +
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/apps/desktop-publisher/src/desktop-publish-targets.ts b/apps/desktop-publisher/src/desktop-publish-targets.ts
index 3270b99b..42e212c6 100644
--- a/apps/desktop-publisher/src/desktop-publish-targets.ts
+++ b/apps/desktop-publisher/src/desktop-publish-targets.ts
@@ -8,7 +8,7 @@ export const desktopPackageWorkflows = {
   'win-x64': '.github/workflows/windows-package.yml',
 } as const
 
-const targetSchema = z.enum(['mac-arm64', 'mac-x64', 'win-x64'])
+const targetSchema = z.enum(['mac-arm64', 'mac-x64', 'win-x64', 'linux-arm64'])
 
 /** Machine labels are unique; a scalar target is shorthand for a one-element target list. */
 export const desktopPublishRunnersSchema = z.record(z.string(), z.object({
diff --git a/apps/desktop-publisher/src/desktop-release-store.ts b/apps/desktop-publisher/src/desktop-release-store.ts
index ae791544..98bdb281 100644
--- a/apps/desktop-publisher/src/desktop-release-store.ts
+++ b/apps/desktop-publisher/src/desktop-release-store.ts
@@ -17,7 +17,7 @@ const sourceSchema = z.strictObject({
   channel: z.enum(['nightly', 'stable']),
   runnerName: z.string().min(1),
   // Storage accepts every Desktop target; CI routing separately limits currently provisioned platforms.
-  target: z.enum(['mac-arm64', 'mac-x64', 'win-x64']),
+  target: z.enum(['mac-arm64', 'mac-x64', 'win-x64', 'linux-arm64']),
   preset: z.enum(['test', 'production']),
   productVersion: z.string().min(1),
   version: z.string().min(1),
diff --git a/apps/desktop/scripts/desktop-upload-plan.ts b/apps/desktop/scripts/desktop-upload-plan.ts
index 2e57bdb4..a68f939a 100644
--- a/apps/desktop/scripts/desktop-upload-plan.ts
+++ b/apps/desktop/scripts/desktop-upload-plan.ts
@@ -24,6 +24,7 @@ const TARGETS = {
   'mac-arm64': { platform: 'darwin', arch: 'arm64', os: 'mac' },
   'mac-x64': { platform: 'darwin', arch: 'x64', os: 'mac' },
   'win-x64': { platform: 'win32', arch: 'x64', os: 'win' },
+  'linux-arm64': { platform: 'linux', arch: 'arm64', os: 'linux' },
 } as const satisfies Record<DesktopPackageTargetName, {
   readonly platform: NodeJS.Platform
   readonly arch: string
-- 
