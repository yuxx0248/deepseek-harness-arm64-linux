From 3def80ab30188dc7e1266d099737792a813ccf7a Mon Sep 17 00:00:00 2001
From: zuohang <jimyu1994@gmail.com>
Date: Tue, 24 Nov 2026 16:44:17 -0800
Subject: [PATCH 19/19] Accept linux in the desktop policy identity

---
 apps/desktop/src/mandatory-update-policy.ts | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/mandatory-update-policy.ts b/apps/desktop/src/mandatory-update-policy.ts
index 44777281..e933cd5d 100644
--- a/apps/desktop/src/mandatory-update-policy.ts
+++ b/apps/desktop/src/mandatory-update-policy.ts
@@ -6,7 +6,7 @@ import { platformClientHeaders } from '@deepseek-ai/dsh-deepseek-account/client-
 
 /** Installed release identity; no field is supplied by a renderer. */
 export interface DesktopPolicyIdentity {
-  readonly platform: 'win32' | 'darwin'
+  readonly platform: 'win32' | 'darwin' | 'linux'
   readonly bundledDshVersion: string
   readonly arch: 'x64' | 'arm64'
   readonly channel: 'nightly' | 'stable'
@@ -160,7 +160,8 @@ export class DesktopMandatoryUpdatePolicy {
   /** Platform headers for one check; the calling UI's language and UTC offset are read now. */
   private requestHeaders(channel: DesktopPolicyIdentity['channel']): Record<string, string> {
     return {
-      ...platformClientHeaders(this.identity.platform, this.client()),
+      // No desktop client platform exists for linux, so its headers resolve as `null`.
+      ...platformClientHeaders(this.identity.platform === 'linux' ? null : this.identity.platform, this.client()),
       'x-client-arch': this.identity.arch, 'x-client-update-channel': channel,
       'x-client-bundled-dsh-version': this.identity.bundledDshVersion,
     }
-- 
